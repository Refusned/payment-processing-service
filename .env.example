# Скопируйте в .env, если нужно поменять значения по умолчанию.
# Без .env compose запускается с теми же значениями.

API_KEY=dev-api-key
DOCS_ENABLED=false

# Эмулятор платёжного шлюза
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

CONSUMER_PREFETCH=10

# Порты на хосте (слушают только 127.0.0.1)
API_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
WEBHOOK_RECEIVER_PORT=9000
